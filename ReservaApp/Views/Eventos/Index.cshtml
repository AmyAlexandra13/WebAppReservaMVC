@model IEnumerable<ReservaApp.Models.ViewModels.EventoViewModel>
@{
    ViewData["Title"] = "Gestión de Eventos";
}

<div class="eventos-container">
    <div class="eventos-header">
        <div class="header-content">
            <h1><i class="fas fa-calendar-alt"></i> Gestión de Eventos</h1>
            <p>Administra tus eventos de manera fácil y eficiente</p>
        </div>
        <a asp-action="Create" class="btn btn-create">
            <i class="fas fa-plus-circle"></i> Nuevo Evento
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="fas fa-calendar-times"></i>
            <h3>No hay eventos creados</h3>
            <p>Comienza creando tu primer evento</p>
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus-circle"></i> Crear Primer Evento
            </a>
        </div>
    }
    else
    {
        <div class="eventos-grid">
            @foreach (var evento in Model)
            {
                <div class="evento-card @(!evento.Activo ? "inactive" : "")">
                    <div class="card-header">
                        <div class="event-date">
                            <div class="date-day">@evento.Fecha.Day</div>
                            <div class="date-month">@evento.Fecha.ToString("MMM")</div>
                        </div>
                        <div class="event-status">
                            @if (evento.Activo)
                            {
                                <span class="badge badge-active">
                                    <i class="fas fa-check-circle"></i> Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-inactive">
                                    <i class="fas fa-times-circle"></i> Inactivo
                                </span>
                            }
                        </div>
                    </div>

                    <div class="card-body">
                        <h3 class="event-title">@evento.Titulo</h3>

                        <div class="event-info">
                            <div class="info-item">
                                <i class="fas fa-map-marker-alt"></i>
                                <span>@evento.Lugar</span>
                            </div>
                            <div class="info-item">
                                <i class="fas fa-clock"></i>
                                <span>@evento.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <div class="info-item">
                                <i class="fas fa-user"></i>
                                <span>@evento.NombreOrganizador</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(evento.Descripcion))
                        {
                            <p class="event-description">
                                @(evento.Descripcion.Length > 100 ? evento.Descripcion.Substring(0, 100) + "..." : evento.Descripcion)
                            </p>
                        }

                        <div class="capacity-info">
                            <div class="capacity-bar">
                                @{
                                    var porcentaje = evento.Capacidad > 0 ? ((evento.Capacidad - evento.CuposDisponibles) * 100 / evento.Capacidad) : 0;
                                }
                                <div class="capacity-fill" style="width: @porcentaje%"></div>
                            </div>
                            <div class="capacity-text">
                                <span><strong>@evento.CuposDisponibles</strong> de @evento.Capacidad disponibles</span>
                                <span class="percentage">@porcentaje.ToString("F0")%</span>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer">
                        <div class="action-buttons">
                            <a asp-action="Details" asp-route-id="@evento.IdEvento" class="btn btn-sm btn-info" title="Ver detalles">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@evento.IdEvento" class="btn btn-sm btn-warning" title="Editar">
                                <i class="fas fa-edit"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-toggle" onclick="toggleActivo(@evento.IdEvento, @evento.Activo.ToString().ToLower())" title="@(evento.Activo ? "Desactivar" : "Activar")">
                                <i class="fas @(evento.Activo ? "fa-toggle-on" : "fa-toggle-off")"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-danger" onclick="confirmDelete(@evento.IdEvento, '@evento.Titulo')" title="Eliminar">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal de confirmación de eliminación -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="fas fa-exclamation-triangle text-warning"></i> Confirmar Eliminación
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>¿Estás seguro de que deseas eliminar el evento <strong id="eventoNombre"></strong>?</p>
                <p class="text-danger"><i class="fas fa-info-circle"></i> Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    <i class="fas fa-trash"></i> Eliminar
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/eventos.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/eventos.js" asp-append-version="true"></script>
    <script>
        let eventoIdToDelete = null;

        function confirmDelete(id, nombre) {
            eventoIdToDelete = id;
            document.getElementById('eventoNombre').textContent = nombre;
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            deleteModal.show();
        }

        document.getElementById('confirmDeleteBtn').addEventListener('click', function() {
            if (eventoIdToDelete) {
                deleteEvento(eventoIdToDelete);
            }
        });

        function deleteEvento(id) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            fetch(`/Eventos/Delete/${id}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showNotification(data.message, 'success');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showNotification(data.message, 'error');
                }
                bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
            })
            .catch(error => {
                showNotification('Error al eliminar el evento', 'error');
                console.error('Error:', error);
            });
        }

        function toggleActivo(id, currentState) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

            fetch(`/Eventos/ToggleActivo/${id}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showNotification(`Evento ${data.activo ? 'activado' : 'desactivado'} exitosamente`, 'success');
                    setTimeout(() => location.reload(), 1000);
                } else {
                    showNotification(data.message, 'error');
                }
            })
            .catch(error => {
                showNotification('Error al cambiar el estado', 'error');
                console.error('Error:', error);
            });
        }

        function showNotification(message, type) {
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            const icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle';

            const alert = document.createElement('div');
            alert.className = `alert ${alertClass} alert-dismissible fade show notification-toast`;
            alert.innerHTML = `
                <i class="fas ${icon}"></i> ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;

            document.querySelector('.eventos-container').insertBefore(alert, document.querySelector('.eventos-header').nextSibling);

            setTimeout(() => alert.remove(), 3000);
        }
    </script>

    <!-- Token antifalsificación para AJAX -->
    @Html.AntiForgeryToken()
}