@model ReservaApp.Models.ViewModels.EventoViewModel
@{
    ViewData["Title"] = "Detalles del Evento";
    var userRole = Context.Session.GetString("UserRole");
    var isAdmin = userRole == "admin";
}

<div class="details-container">
    <!-- Botón de Regresar -->
    <div class="details-header">
        <a asp-action="Index" class="btn-back">
            <i class="fas fa-arrow-left"></i> Volver a Eventos
        </a>
    </div>

    <!-- Información Principal del Evento -->
    <div class="event-details-card">
        <div class="event-header">
            <div class="event-date-large">
                <div class="date-day">@Model.Fecha.Day</div>
                <div class="date-month">@Model.Fecha.ToString("MMM").ToUpper()</div>
                <div class="date-year">@Model.Fecha.Year</div>
            </div>
            <div class="event-header-info">
                <h1 class="event-title">@Model.Titulo</h1>
                <div class="event-meta">
                    @if (Model.Activo)
                    {
                        <span class="badge badge-success">
                            <i class="fas fa-check-circle"></i> Evento Activo
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-danger">
                            <i class="fas fa-times-circle"></i> Evento Inactivo
                        </span>
                    }
                    <span class="event-id">#@Model.IdEvento</span>
                </div>
            </div>
        </div>

        <!-- Información Detallada -->
        <div class="event-details-body">
            <div class="details-grid">
                <!-- Fecha y Hora -->
                <div class="detail-item">
                    <div class="detail-icon">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                    <div class="detail-content">
                        <label>Fecha y Hora</label>
                        <p>@Model.Fecha.ToString("dddd, dd 'de' MMMM 'de' yyyy")</p>
                        <p class="text-muted">@Model.Fecha.ToString("HH:mm")</p>
                    </div>
                </div>

                <!-- Ubicación -->
                <div class="detail-item">
                    <div class="detail-icon">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <div class="detail-content">
                        <label>Ubicación</label>
                        <p>@Model.Lugar</p>
                    </div>
                </div>

                <!-- Organizador -->
                <div class="detail-item">
                    <div class="detail-icon">
                        <i class="fas fa-user-tie"></i>
                    </div>
                    <div class="detail-content">
                        <label>Organizador</label>
                        <p>@Model.NombreOrganizador</p>
                        <p class="text-muted">@Model.EmailOrganizador</p>
                    </div>
                </div>

                <!-- Capacidad -->
                <div class="detail-item">
                    <div class="detail-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="detail-content">
                        <label>Capacidad</label>
                        <p><strong>@Model.CuposDisponibles</strong> de @Model.Capacidad disponibles</p>
                        @{
                            var porcentaje = Model.Capacidad > 0 ? ((Model.Capacidad - Model.CuposDisponibles) * 100.0 / Model.Capacidad) : 0;
                        }
                        <div class="capacity-bar">
                            <div class="capacity-fill" style="width: @porcentaje.ToString("F0")%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Descripción -->
            @if (!string.IsNullOrEmpty(Model.Descripcion))
            {
                <div class="description-section">
                    <h3><i class="fas fa-align-left"></i> Descripción del Evento</h3>
                    <p>@Model.Descripcion</p>
                </div>
            }

            <!-- Información Adicional -->
            <div class="additional-info">
                <div class="info-row">
                    <span class="info-label"><i class="fas fa-clock"></i> Fecha de Creación:</span>
                    <span class="info-value">@Model.FechaCreacion?.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="info-row">
                    <span class="info-label"><i class="fas fa-chart-line"></i> Ocupación:</span>
                    <span class="info-value">@porcentaje.ToString("F1")%</span>
                </div>
            </div>
        </div>

        <!-- Botones de Acción (Solo para organizador/admin) -->
        @if (isAdmin || Model.NombreOrganizador == Context.Session.GetString("UserName"))
        {
            <div class="event-actions">
                <a asp-action="Edit" asp-route-id="@Model.IdEvento" class="btn btn-warning">
                    <i class="fas fa-edit"></i> Editar Evento
                </a>
                <button type="button" class="btn btn-danger" onclick="confirmDelete(@Model.IdEvento, '@Model.Titulo')">
                    <i class="fas fa-trash"></i> Eliminar Evento
                </button>
            </div>
        }
    </div>

    <!-- Sección de Reservas (Solo para Admin) -->
    @if (isAdmin)
    {
        <div class="reservas-section">
            <div class="reservas-header">
                <h2><i class="fas fa-ticket-alt"></i> Reservas del Evento</h2>
                <span class="reservas-count" id="reservasCount">Cargando...</span>
            </div>

            <div class="reservas-filters">
                <div class="filter-group">
                    <label><i class="fas fa-filter"></i> Filtrar por estado:</label>
                    <select id="estadoFilter" class="form-select">
                        <option value="">Todos los estados</option>
                        <option value="confirmada">Confirmada</option>
                        <option value="pendiente">Pendiente</option>
                        <option value="cancelada">Cancelada</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label><i class="fas fa-search"></i> Buscar usuario:</label>
                    <input type="text" id="usuarioSearch" class="form-control" placeholder="Nombre o email...">
                </div>
            </div>

            <div id="reservasContainer" class="reservas-container">
                <div class="loading-spinner">
                    <i class="fas fa-spinner fa-spin"></i> Cargando reservas...
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal de Confirmación de Eliminación -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="fas fa-exclamation-triangle text-warning"></i> Confirmar Eliminación
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>¿Estás seguro de que deseas eliminar el evento <strong id="eventoNombre"></strong>?</p>
                <p class="text-danger"><i class="fas fa-info-circle"></i> Esta acción no se puede deshacer.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">
                    <i class="fas fa-trash"></i> Eliminar
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/evento-details.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        const eventoId = @Model.IdEvento;
        const isAdmin = @(isAdmin ? "true" : "false");

        @if (isAdmin)
        {
            <text>
                // Cargar reservas al iniciar
                document.addEventListener('DOMContentLoaded', function() {
                    loadReservas();

                    // Event listeners para filtros
                    document.getElementById('estadoFilter').addEventListener('change', filterReservas);
                    document.getElementById('usuarioSearch').addEventListener('input', filterReservas);
                });

                // Cargar reservas del evento
                async function loadReservas() {
                    try {
                        const response = await fetch(`/api/eventos/${eventoId}/reservas`);

                        if (!response.ok) {
                            throw new Error('Error al cargar reservas');
                        }

                        const reservas = await response.json();
                        displayReservas(reservas);
                    } catch (error) {
                        console.error('Error:', error);
                        document.getElementById('reservasContainer').innerHTML = `
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle"></i>
                                No se pudieron cargar las reservas. Por favor, intenta nuevamente.
                            </div>
                        `;
                    }
                }

                // Mostrar reservas en la interfaz
                function displayReservas(reservas) {
                    const container = document.getElementById('reservasContainer');
                    const countElement = document.getElementById('reservasCount');

                    countElement.textContent = `${reservas.length} reserva${reservas.length !== 1 ? 's' : ''}`;

                    if (reservas.length === 0) {
                        container.innerHTML = `
                            <div class="empty-reservas">
                                <i class="fas fa-inbox"></i>
                                <p>No hay reservas para este evento</p>
                            </div>
                        `;
                        return;
                    }

                    let html = '<div class="reservas-table-container"><table class="reservas-table">';
                    html += `
                        <thead>
                            <tr>
                                <th>Usuario</th>
                                <th>Email</th>
                                <th>Cupos</th>
                                <th>Estado</th>
                                <th>Fecha de Reserva</th>
                            </tr>
                        </thead>
                        <tbody>
                    `;

                    reservas.forEach(reserva => {
                        const estadoBadge = getEstadoBadge(reserva.estado);
                        const fechaFormateada = new Date(reserva.fechaReserva).toLocaleDateString('es-ES', {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit'
                        });

                        html += `
                            <tr data-estado="${reserva.estado}" data-usuario="${reserva.nombreUsuario.toLowerCase()} ${reserva.email.toLowerCase()}">
                                <td>
                                    <div class="user-cell">
                                        <i class="fas fa-user-circle"></i>
                                        <span>${reserva.nombreUsuario}</span>
                                    </div>
                                </td>
                                <td>${reserva.email}</td>
                                <td class="text-center"><strong>${reserva.cantidadCupos}</strong></td>
                                <td>${estadoBadge}</td>
                                <td>${fechaFormateada}</td>
                            </tr>
                        `;
                    });

                    html += '</tbody></table></div>';
                    container.innerHTML = html;
                }

                // Obtener badge de estado
                function getEstadoBadge(estado) {
                    const badges = {
                        'confirmada': '<span class="badge badge-success"><i class="fas fa-check-circle"></i> Confirmada</span>',
                        'pendiente': '<span class="badge badge-warning"><i class="fas fa-clock"></i> Pendiente</span>',
                        'cancelada': '<span class="badge badge-danger"><i class="fas fa-times-circle"></i> Cancelada</span>'
                    };
                    return badges[estado] || `<span class="badge badge-secondary">${estado}</span>`;
                }

                // Filtrar reservas
                function filterReservas() {
                    const estadoFilter = document.getElementById('estadoFilter').value.toLowerCase();
                    const usuarioSearch = document.getElementById('usuarioSearch').value.toLowerCase();
                    const rows = document.querySelectorAll('.reservas-table tbody tr');

                    let visibleCount = 0;

                    rows.forEach(row => {
                        const estado = row.getAttribute('data-estado');
                        const usuario = row.getAttribute('data-usuario');

                        const estadoMatch = !estadoFilter || estado === estadoFilter;
                        const usuarioMatch = !usuarioSearch || usuario.includes(usuarioSearch);

                        if (estadoMatch && usuarioMatch) {
                            row.style.display = '';
                            visibleCount++;
                        } else {
                            row.style.display = 'none';
                        }
                    });

                    // Actualizar contador
                    const totalReservas = rows.length;
                    document.getElementById('reservasCount').textContent =
                        visibleCount === totalReservas
                            ? `${totalReservas} reserva${totalReservas !== 1 ? 's' : ''}`
                            : `${visibleCount} de ${totalReservas} reservas`;
                }
            </text>
        }

        // Confirmar eliminación
        function confirmDelete(id, nombre) {
            document.getElementById('eventoNombre').textContent = nombre;
            const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
            modal.show();

            document.getElementById('confirmDeleteBtn').onclick = () => deleteEvento(id);
        }

        // Eliminar evento
        async function deleteEvento(id) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            try {
                const response = await fetch(`/Eventos/Delete/${id}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    }
                });

                const data = await response.json();

                if (data.success) {
                    showNotification(data.message, 'success');
                    setTimeout(() => window.location.href = '/Eventos/Index', 1500);
                } else {
                    showNotification(data.message, 'error');
                }

                bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
            } catch (error) {
                console.error('Error:', error);
                showNotification('Error al eliminar el evento', 'error');
            }
        }

        // Mostrar notificación
        function showNotification(message, type = 'info') {
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            const icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle';

            const notification = document.createElement('div');
            notification.className = `alert ${alertClass} alert-dismissible fade show notification-toast`;
            notification.innerHTML = `
                <i class="fas ${icon}"></i> ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;

            document.body.appendChild(notification);
            setTimeout(() => notification.remove(), 3000);
        }
    </script>

    @Html.AntiForgeryToken()
}