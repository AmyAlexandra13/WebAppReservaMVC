@model ReservaApp.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Registrarse";
    Layout = "~/Views/Shared/_LayoutAuth.cshtml";
}

<div class="auth-card">
    <div class="auth-card-header">
        <i class="fas fa-user-plus"></i>
        <h2>Crear Cuenta</h2>
        <p>Únete y comienza a reservar eventos increíbles</p>
    </div>

    <form asp-action="Register" method="post" class="auth-form" id="registerForm">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="form-group">
            <label asp-for="Nombre" class="form-label">
                <i class="fas fa-user"></i> Nombre Completo
            </label>
            <input asp-for="Nombre" class="form-control" placeholder="Juan Pérez" autocomplete="name" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email" class="form-label">
                <i class="fas fa-envelope"></i> Correo Electrónico
            </label>
            <input asp-for="Email" class="form-control" placeholder="tu@email.com" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password" class="form-label">
                <i class="fas fa-lock"></i> Contraseña
            </label>
            <div class="password-input-wrapper">
                <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="new-password" id="passwordInput" />
                <button type="button" class="password-toggle" id="togglePassword">
                    <i class="fas fa-eye" id="eyeIcon"></i>
                </button>
            </div>
            <div class="password-strength" id="passwordStrength">
                <div class="strength-bar">
                    <div class="strength-bar-fill" id="strengthBarFill"></div>
                </div>
                <small id="strengthText">Ingresa una contraseña</small>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword" class="form-label">
                <i class="fas fa-lock"></i> Confirmar Contraseña
            </label>
            <div class="password-input-wrapper">
                <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" autocomplete="new-password" id="confirmPasswordInput" />
                <button type="button" class="password-toggle" id="toggleConfirmPassword">
                    <i class="fas fa-eye" id="eyeIconConfirm"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-block">
            <i class="fas fa-user-plus"></i> Crear Cuenta
        </button>

        <div class="auth-footer">
            <p>¿Ya tienes una cuenta? <a asp-action="Login">Inicia sesión aquí</a></p>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/auth.js"></script>
}