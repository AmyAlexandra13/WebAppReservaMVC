@model ReservaApp.Models.ViewModels.EventoDisponibleViewModel
@{
    ViewData["Title"] = "Detalles del Evento";
    var porcentajeOcupacion = Model.Capacidad > 0 ? ((Model.Capacidad - Model.CuposDisponibles) * 100.0 / Model.Capacidad) : 0;
    var diasRestantes = (Model.Fecha - DateTime.Now).Days;
}

<div class="details-container">
    <div class="details-header">
        <a asp-action="Eventos" class="btn-back">
            <i class="fas fa-arrow-left"></i> Volver a Eventos
        </a>
    </div>

    <div class="event-details-card">
        @if (Model.TieneReserva)
        {
            <div class="alert alert-success alert-reservado">
                <i class="fas fa-check-circle"></i>
                <strong>¡Ya tienes una reserva para este evento!</strong>
                <span>Has reservado @Model.CuposReservados cupo(s)</span>
            </div>
        }

        <div class="event-header">
            <div class="event-date-large">
                <div class="date-day">@Model.Fecha.Day</div>
                <div class="date-month">@Model.Fecha.ToString("MMM").ToUpper()</div>
                <div class="date-year">@Model.Fecha.Year</div>

                @if (diasRestantes <= 7 && diasRestantes > 0)
                {
                    <div class="countdown-badge">
                        <i class="fas fa-clock"></i> @diasRestantes día(s)
                    </div>
                }
            </div>
            <div class="event-header-info">
                <h1 class="event-title">@Model.Titulo</h1>
                <div class="event-meta">
                    <span class="badge badge-primary">
                        <i class="fas fa-calendar-check"></i> Evento Disponible
                    </span>
                    @if (Model.CuposDisponibles < 10)
                    {
                        <span class="badge badge-warning">
                            <i class="fas fa-exclamation-triangle"></i> ¡Últimos Cupos!
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="event-details-body">
            <div class="details-grid">
                <div class="detail-item">
                    <div class="detail-icon">
                        <i class="fas fa-calendar-alt"></i>
                    </div>
                    <div class="detail-content">
                        <label>Fecha y Hora</label>
                        <p>@Model.Fecha.ToString("dddd, dd 'de' MMMM 'de' yyyy")</p>
                        <p class="text-muted">@Model.Fecha.ToString("HH:mm")</p>
                    </div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <div class="detail-content">
                        <label>Ubicación</label>
                        <p>@Model.Lugar</p>
                    </div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon">
                        <i class="fas fa-user-tie"></i>
                    </div>
                    <div class="detail-content">
                        <label>Organizador</label>
                        <p>@Model.NombreOrganizador</p>
                        <p class="text-muted">@Model.EmailOrganizador</p>
                    </div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon">
                        <i class="fas fa-users"></i>
                    </div>
                    <div class="detail-content">
                        <label>Disponibilidad</label>
                        <p><strong>@Model.CuposDisponibles</strong> de @Model.Capacidad cupos</p>
                        <div class="capacity-bar">
                            <div class="capacity-fill" style="width: @porcentajeOcupacion.ToString("F0")%"></div>
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Descripcion))
            {
                <div class="description-section">
                    <h3><i class="fas fa-align-left"></i> Descripción del Evento</h3>
                    <p>@Model.Descripcion</p>
                </div>
            }

            <div class="additional-info">
                <div class="info-row">
                    <span class="info-label"><i class="fas fa-chart-line"></i> Ocupación:</span>
                    <span class="info-value">@porcentajeOcupacion.ToString("F1")%</span>
                </div>
                @if (diasRestantes > 0)
                {
                    <div class="info-row">
                        <span class="info-label"><i class="fas fa-hourglass-half"></i> Tiempo restante:</span>
                        <span class="info-value">@diasRestantes día(s)</span>
                    </div>
                }
            </div>
        </div>

        <div class="event-actions">
            @if (Model.TieneReserva)
            {
                <a asp-action="Index" class="btn btn-success btn-lg">
                    <i class="fas fa-ticket-alt"></i> Ver Mis Reservas
                </a>
            }
            else if (Model.CuposDisponibles > 0)
            {
                <button type="button" class="btn btn-primary btn-lg btn-reservar"
                        data-evento-id="@Model.IdEvento"
                        data-evento-titulo="@Model.Titulo"
                        data-cupos-disponibles="@Model.CuposDisponibles">
                    <i class="fas fa-ticket-alt"></i> Reservar Ahora
                </button>
            }
            else
            {
                <button type="button" class="btn btn-secondary btn-lg" disabled>
                    <i class="fas fa-times-circle"></i> Sin Cupos Disponibles
                </button>
            }

            <a asp-action="Eventos" class="btn btn-outline-secondary btn-lg">
                <i class="fas fa-arrow-left"></i> Ver Otros Eventos
            </a>
        </div>
    </div>
</div>

<!-- Modal de Reserva -->
<div class="modal fade" id="reservaModal" tabindex="-1" aria-labelledby="reservaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="reservaModalLabel">
                    <i class="fas fa-ticket-alt"></i> Reservar Evento
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <h4 id="eventoTitulo" class="mb-3">@Model.Titulo</h4>

                <div class="form-group">
                    <label for="cantidadCupos" class="form-label">
                        <i class="fas fa-users"></i> Cantidad de Cupos
                    </label>
                    <input type="number" id="cantidadCupos" class="form-control" value="1" min="1" max="10" />
                    <small class="form-text text-muted">
                        Cupos disponibles: <span id="cuposDisponibles">@Model.CuposDisponibles</span>
                    </small>
                </div>

                <div class="alert alert-info mt-3">
                    <i class="fas fa-info-circle"></i>
                    <strong>Nota:</strong> Tu reserva será confirmada inmediatamente. Asegúrate de poder asistir al evento.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="confirmarReservaBtn">
                    <i class="fas fa-check"></i> Confirmar Reserva
                </button>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/evento-details.css" asp-append-version="true" />
    <style>
        .alert-reservado {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 1.5rem;
            margin-bottom: 2rem;
            border-radius: 0.75rem;
            flex-wrap: wrap;
        }

            .alert-reservado strong {
                flex: 1;
                min-width: 200px;
            }

        .countdown-badge {
            background: #f59e0b;
            color: white;
            padding: 0.5rem;
            border-radius: 0.5rem;
            margin-top: 0.5rem;
            font-size: 0.875rem;
            font-weight: 600;
            text-align: center;
        }
    </style>
}

@section Scripts {
    <script>
        let eventoIdSeleccionado = @Model.IdEvento;
        let cuposMaximos = @Model.CuposDisponibles;

        document.addEventListener('DOMContentLoaded', function() {
            const btnReservar = document.querySelector('.btn-reservar');
            if (btnReservar) {
                btnReservar.addEventListener('click', function() {
                    const modal = new bootstrap.Modal(document.getElementById('reservaModal'));
                    document.getElementById('cantidadCupos').max = Math.min(10, cuposMaximos);
                    modal.show();
                });
            }

            const confirmarBtn = document.getElementById('confirmarReservaBtn');
            if (confirmarBtn) {
                confirmarBtn.addEventListener('click', confirmarReserva);
            }
        });

        async function confirmarReserva() {
            const cantidadCupos = parseInt(document.getElementById('cantidadCupos').value);

            if (cantidadCupos < 1 || cantidadCupos > cuposMaximos) {
                showNotification('Cantidad de cupos inválida', 'error');
                return;
            }

            const btn = document.getElementById('confirmarReservaBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Procesando...';

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            try {
                const response = await fetch('/Reservas/Crear', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `eventoId=${eventoIdSeleccionado}&cantidadCupos=${cantidadCupos}`
                });

                const data = await response.json();

                if (data.success) {
                    showNotification(data.message, 'success');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    showNotification(data.message, 'error');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-check"></i> Confirmar Reserva';
                }

                bootstrap.Modal.getInstance(document.getElementById('reservaModal')).hide();
            } catch (error) {
                console.error('Error:', error);
                showNotification('Error al crear la reserva', 'error');
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check"></i> Confirmar Reserva';
            }
        }

        function showNotification(message, type = 'info') {
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            const icon = type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle';

            const notification = document.createElement('div');
            notification.className = `alert ${alertClass} alert-dismissible fade show notification-toast`;
            notification.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                z-index: 9999;
                min-width: 300px;
                box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            `;

            notification.innerHTML = `
                <i class="fas ${icon}"></i> ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;

            document.body.appendChild(notification);

            setTimeout(() => notification.remove(), 3000);
        }
    </script>

    @Html.AntiForgeryToken()
}