@{
    ViewData["Title"] = "Crear Usuario de Prueba";
}

<div class="container mt-5">
    <div class="card">
        <div class="card-header bg-success text-white">
            <h2><i class="fas fa-user-plus"></i> Crear Usuario de Prueba</h2>
        </div>
        <div class="card-body">
            @if (ViewBag.Message != null)
            {
                <div class="alert alert-info">
                    <h4>@ViewBag.Message</h4>
                    @if (ViewBag.Email != null)
                    {
                        <hr>
                        <p><strong>Email:</strong> @ViewBag.Email</p>
                        <p><strong>Password:</strong> @ViewBag.Password</p>
                        <p><strong>User ID:</strong> @ViewBag.UserId</p>
                    }
                </div>
            }

            <div class="mt-4">
                <a href="/Test/LoginTestUser" class="btn btn-primary">
                    <i class="fas fa-sign-in-alt"></i> Iniciar Sesión con Este Usuario
                </a>
                <a href="/Account/Login" class="btn btn-secondary">
                    <i class="fas fa-sign-in-alt"></i> Ir a Login Normal
                </a>
                <a href="/Test/Session" class="btn btn-info">
                    <i class="fas fa-vial"></i> Verificar Sesión
                </a>
            </div>
        </div>
    </div>
</div>